<?xml version='1.0' encoding='utf-8'?>
<icecast>

    <location>Earth</location>
    <admin>icemaster@localhost</admin>

    <!-- ── Limits ────────────────────────────────────────────────────────────
         clients     = total simultaneous connections (listeners + sources + admin)
                       Set to 10000 — Icecast is lightweight per-listener (~36 KB RAM).
                       Practical CPU ceiling on 1 vCPU is ~800–1000 listeners.
                       Raise droplet to 2 vCPU when consistently hitting 800 listeners.
         sources     = max encoder/presenter connections (5 = plenty of headroom)
         queue-size  = per-listener audio buffer in bytes.
                       32768 (32 KB) = ~2s at 128kbps. Keeps RAM usage low at scale.
                       (Default was 524288 / 512 KB — that's 512 MB RAM at 1000 listeners)
    ──────────────────────────────────────────────────────────────────────── -->
    <limits>
        <clients>10000</clients>
        <sources>5</sources>
        <queue-size>32768</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>16384</burst-size>      <!-- ~1s of audio at 128kbps on connect -->
    </limits>

    <!-- ── Authentication ───────────────────────────────────────────────────
         source-password = used by FFmpeg/gateway to push the stream
         admin-password  = Icecast web admin panel at /admin
         Keep these in sync with gateway/.env ICECAST_PASSWORD
    ──────────────────────────────────────────────────────────────────────── -->
    <authentication>
        <!-- Real passwords live on the server only — never commit actual values.
             source-password must match ICECAST_PASSWORD in gateway/.env -->
        <source-password>ICECAST_SOURCE_PASSWORD</source-password>
        <relay-password>ICECAST_RELAY_PASSWORD</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>ICECAST_ADMIN_PASSWORD</admin-password>
    </authentication>

    <hostname>178.128.46.95</hostname>

    <listen-socket>
        <port>8000</port>
    </listen-socket>

    <!-- Allow all origins so the browser audio element can connect cross-domain -->
    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*" />
    </http-headers>

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/status.xsl" />
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>1</loglevel>             <!-- 1=error only — reduce log noise in production -->
        <logsize>102400</logsize>          <!-- 100 KB max log file size -->
    </logging>

    <security>
        <chroot>0</chroot>
    </security>

    <!-- ── Main stream mount ─────────────────────────────────────────────────
         max-listeners = cap for /stream mount specifically.
                         Set to 9995 — leaves 5 slots for sources/admin within
                         the global <clients>10000</clients> limit.
         burst-size    = how much audio to send immediately on connect (catch-up).
                         4096 bytes = ~0.25s at 128kbps. Small = fast start,
                         and new listeners stay close to the live edge.
         queue-size    = per-listener buffer. 16384 = 16 KB = ~1s at 128kbps.
         bitrate       = must match FFmpeg -b:a value (128k). Informational only
                         but used by some players and directory listings.
    ──────────────────────────────────────────────────────────────────────── -->
    <mount type="normal">
        <mount-name>/stream</mount-name>
        <username>source</username>
        <password>ICECAST_SOURCE_PASSWORD</password>
        <max-listeners>9995</max-listeners>
        <burst-size>4096</burst-size>
        <queue-size>16384</queue-size>
        <public>1</public>
        <stream-name>Al-Manhaj Radio</stream-name>
        <stream-description>Islamic lectures and Quran recitation following the way of the Salaf</stream-description>
        <stream-url>https://almanhaj.vercel.app</stream-url>
        <genre>Religious</genre>
        <bitrate>96</bitrate>
        <type>audio/mpeg</type>
        <fallback-mount>/offline.mp3</fallback-mount>
        <fallback-override>1</fallback-override>
        <fallback-when-full>1</fallback-when-full>
    </mount>

    <!-- Offline/fallback mount — played when no source is connected -->
    <mount type="normal">
        <mount-name>/offline.mp3</mount-name>
        <public>0</public>
        <stream-name>Al-Manhaj Radio - Offline</stream-name>
        <stream-description>We are currently offline. Please check back later.</stream-description>
        <type>audio/mpeg</type>
    </mount>

</icecast>
